{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArenaFX",
  "version": "2.0.0",
  "identifier": "ch.kammermann.arenafx",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ArenaFX",
        "url": "login.html",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "media-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Music",
    "shortDescription": "Soundbox für Eishockey-Spiele",
    "longDescription": "ArenaFX spielt Unterbruchsmusik und Effekt-Töne für Eishockey-Spiele ab – mit Teams, Durchsage-Funktion und frei belegbaren Tastenkürzeln.",
    "copyright": "© 2026 Stefan Kammermann",
    "publisher": "Stefan Kammermann",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English", "French"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1MDc4MDI5MUUzRjAzMzQKUldRMEF6OGVLWUFIbFFqamNQUW1ncVB5WG8vV2VQRkpTeGZqRGQrRnVYQ2xGMXhhbmFUWWswODgK",
      "endpoints": [
        "https://github.com/Kammermanns/ArenaFX/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
